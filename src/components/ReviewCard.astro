---
/**
 * One Google review, laid out like it is on Google Maps: avatar and name, then stars and date,
 * then the text. Colours follow the section it sits in, so it works on white and on black.
 */
import type { Review } from '../reviews';
import { withBase } from '../utils/paths';

interface Props {
  review: Review;
}
const { review } = Astro.props;
const initial = review.author.trim().charAt(0).toUpperCase();
---

<div class="review-head">
  {review.photo ? (
    <img class="avatar" src={withBase(review.photo)} alt="" width="40" height="40" loading="lazy" />
  ) : (
    <span class="avatar" aria-hidden="true">{initial}</span>
  )}
  <span class="review-author">{review.author}</span>
</div>
<div class="review-meta">
  <span class="stars" role="img" aria-label={`${review.rating} out of 5 stars`}>
    <span class="stars-on">{'★'.repeat(review.rating)}</span><span class="stars-off">{'★'.repeat(5 - review.rating)}</span>
  </span>
  <span class="review-date">{review.date}</span>
</div>
<blockquote class="review-text">{review.text}</blockquote>
<p class="review-source">Posted on Google</p>

<style>
  .review-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
    color: var(--muted);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .review-author {
    font-weight: 700;
    color: var(--text);
  }
  /* Stars in Google's yellow, then the date */
  .review-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.85rem 0 0.6rem;
  }
  .stars {
    font-size: 1rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .stars-on {
    color: #fbbc04;
  }
  .stars-off {
    color: var(--line);
  }
  .review-date {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .review-text {
    margin: 0;
    color: var(--text);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.6;
  }
  .review-source {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }
</style>
