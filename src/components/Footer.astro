---
import { BRAND } from '../config';
import logoWhite from '../assets/mustafatheathlete-logo-white.svg';
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container inner">
    <a class="logo" href={withBase('/')} aria-label={`${BRAND} home`}>
      <img src={logoWhite.src} width="550" height="200" alt="" />
    </a>
    <p class="copy">&copy; {year} Mustafa The Athlete</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-block: clamp(1.75rem, 3vw, 2.25rem) 6rem;
  }
  @media (min-width: 760px) {
    .footer {
      padding-bottom: clamp(1.75rem, 3vw, 2.25rem);
    }
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 760px) {
    .inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }
  .logo {
    display: inline-block;
    transition: opacity 0.2s;
  }
  .logo:hover {
    opacity: 0.8;
  }
  .logo img {
    height: clamp(56px, 6vw, 72px);
    width: auto;
  }
  .copy {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }
</style>
