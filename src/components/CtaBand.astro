---
/**
 * Closing booking band: heading and a short line on the left, the WhatsApp button on the right,
 * and a "Prefer email?" link to the /book/ page.
 */
import WhatsAppButton from './WhatsAppButton.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  text: string;
  buttonLabel?: string;
  tone?: 'dark' | 'light' | 'grey';
}
const { title, text, buttonLabel, tone = 'dark' } = Astro.props;
---

<section class:list={['cta', tone === 'dark' ? 'on-dark' : tone === 'grey' ? 'grey' : 'light']} aria-label="Get started">
  <div class:list={['container', 'band', { 'band--centered': tone === 'grey' }]}>
    {tone === 'grey' ? (
      <div class="booking-content">
        <div class="band-text">
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
        <div class="band-action">
          <WhatsAppButton label={buttonLabel} />
        </div>
        <p class="email-prompt email-cta">Prefer email? <a class="email-link" href={withBase('/book/')}>Send an enquiry</a></p>
      </div>
    ) : (
      <>
        <div class="band-text">
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
        <div class="band-action">
          <WhatsAppButton label={buttonLabel} />
        </div>
      <div class="band-form">
        <p class="email-prompt">Prefer email? <a class="email-link" href={withBase('/book/')}>Send an enquiry</a></p>
      </div>
      </>
    )}
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .light {
    background: var(--surface);
    color: var(--text);
  }
  .grey {
    background: #fff;
    color: var(--text);
  }
  .band {
    /* Same editorial measure as the Services rows */
    max-width: calc(960px + 2 * var(--pad));
    display: grid;
    gap: 1.25rem 2rem;
    align-items: center;
  }
  .band--centered {
    display: block;
  }
  .band-text h2 {
    margin: 0 0 0.4rem;
    text-align: left;
  }
  /* One centred column: heading, line, the WhatsApp button, then the email line close under it */
  .booking-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .booking-content .band-text h2 {
    text-align: center;
    margin-bottom: 0.75rem;
  }
  /* Narrower, and balanced so the two lines come out roughly even */
  .booking-content .band-text p {
    max-width: 28rem;
    margin-inline: auto;
    line-height: 1.7;
    text-wrap: balance;
  }
  .booking-content .band-action {
    width: min(100%, 15rem);
    margin-top: 1.75rem;
  }
  .booking-content .band-action :global(.btn) {
    width: 100%;
  }
  /* Plain text under the WhatsApp button, as on the home page: only "Send an enquiry" is a link */
  .email-cta {
    margin: 0.6rem 0 0;
    text-align: center;
  }
  .band-text p {
    margin: 0;
    color: var(--muted);
  }
  .band-form {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .band-form :global(.email-link) {
    margin-top: 0;
  }
  .band-form :global(.email-prompt) {
    margin: 0;
  }
  @media (min-width: 760px) {
    .band {
      grid-template-columns: 1fr auto;
    }
    .band-form {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .booking-content .band-action {
      width: 100%;
    }
    .band-action :global(.btn) {
      width: 100%;
    }
  }
</style>
