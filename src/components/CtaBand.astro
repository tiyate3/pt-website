---
/**
 * Closing booking band: heading and a short line on the left, the WhatsApp button on the right,
 * and a "Prefer email?" link to the /book/ page.
 */
import WhatsAppButton from './WhatsAppButton.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  text: string;
  buttonLabel?: string;
  tone?: 'dark' | 'light' | 'grey';
}
const { title, text, buttonLabel, tone = 'dark' } = Astro.props;
---

<section class:list={['cta', tone === 'dark' ? 'on-dark' : tone === 'grey' ? 'grey' : 'light']} aria-label="Get started">
  <div class:list={['container', 'band', { 'band--centered': tone === 'grey' }]}>
    {tone === 'grey' ? (
      <div class="booking-content">
        <div class="band-text">
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
        <div class="band-action">
          <WhatsAppButton label={buttonLabel} />
        </div>
        <a class="btn email-cta" href={withBase('/book/')}>Prefer email? Send an enquiry</a>
      </div>
    ) : (
      <>
        <div class="band-text">
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
        <div class="band-action">
          <WhatsAppButton label={buttonLabel} />
        </div>
      <div class="band-form">
        <p class="email-prompt">Prefer email? <a class="email-link" href={withBase('/book/')}>Send an enquiry</a></p>
      </div>
      </>
    )}
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .light {
    background: var(--surface);
    color: var(--text);
  }
  .grey {
    background: #fff;
    color: var(--text);
  }
  .band {
    /* Same editorial measure as the Services rows */
    max-width: calc(960px + 2 * var(--pad));
    display: grid;
    gap: 1.25rem 2rem;
    align-items: center;
  }
  .band--centered {
    display: block;
  }
  .band-text h2 {
    margin: 0 0 0.4rem;
    text-align: left;
  }
  .booking-content {
    width: 100%;
    margin-inline: auto;
    display: grid;
    /* Text up to its reading width, the buttons straight after it rather than at the far edge */
    grid-template-columns: minmax(0, 580px) auto;
    justify-content: start;
    align-items: center;
    gap: 0.75rem clamp(2rem, 4vw, 3.5rem);
    text-align: left;
  }
  .booking-content .band-text h2 {
    text-align: left;
    margin-bottom: 0.75rem;
  }
  .booking-content .band-text p {
    max-width: 580px;
    line-height: 1.7;
  }
  /* The text spans both button rows, so the two buttons sit close together beside it */
  .booking-content .band-text {
    grid-row: 1 / span 2;
  }
  .booking-content .band-action {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
  }
  .booking-content .band-action :global(.btn) {
    width: 100%;
  }
  .email-cta {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    --btn-border: var(--text);
    --btn-fill: color-mix(in srgb, var(--text) 8%, transparent);
    --btn-fill-fg: var(--text);
    --btn-fill-border: var(--text);
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    white-space: normal;
    text-align: center;
  }
  .band-text p {
    margin: 0;
    color: var(--muted);
  }
  .band-form {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  /* The WhatsApp button in black and white: inverts to white with a black outline on hover */
  .band-action :global(.btn) {
    --btn-bg: var(--black);
    --btn-fg: #ffffff;
    --btn-border: var(--black);
    --btn-fill: #2a2a2a;
    --btn-fill-fg: #ffffff;
    --btn-fill-border: #2a2a2a;
  }
  .band-form :global(.email-link) {
    margin-top: 0;
  }
  .band-form :global(.email-prompt) {
    margin: 0;
  }
  @media (min-width: 760px) {
    .band {
      grid-template-columns: 1fr auto;
    }
    .band-form {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .booking-content {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .booking-content .band-text h2 {
      text-align: center;
    }
    .booking-content .band-text,
    .booking-content .band-action,
    .email-cta {
      grid-column: 1;
      grid-row: auto;
    }
    .booking-content .band-action :global(.btn),
    .email-cta {
      width: 100%;
    }
    .band-action :global(.btn) {
      width: 100%;
    }
  }
</style>
