---
import { BRAND, NAV } from '../config';
import logoWhite from '../assets/mustafatheathlete-nav-logo.svg';
import { withBase } from '../utils/paths';

// Current page path with the deploy base stripped, always in the form '/services/'
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length);
path = `/${path.replace(/^\/+/, '')}`;
if (!path.endsWith('/')) path += '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!--
  One header row: logo on the left; the links, grouped, then the "Book a session" button on the right.
  Black throughout; only over the top of the home hero is the backing see-through, so the video shows.
  On small screens: logo + menu button, and the links open as a full-screen menu.
-->
<header class="header">
  <div class="bar">
    <a class="logo" href={withBase('/')} aria-label={`${BRAND} home`}>
      <img src={logoWhite.src} width="332" height="90" alt="" />
    </a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav-cta" href={withBase('/book/')} aria-current={isActive('/book/') ? 'page' : undefined}>
        Book a session
      </a>
    </nav>

    <!-- Phones only: BOOK beside the menu button (on desktop, Book a session is in the nav) -->
    <div class="bar-end">
      <a class="bar-book" href={withBase('/book/')} aria-current={isActive('/book/') ? 'page' : undefined}>Book</a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <!-- Phone menu: darkens the page beside the open menu; tapping it closes the menu -->
  <div class="menu-scrim" aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  // Tapping the darkened page or pressing Escape closes the menu
  document.querySelector('.menu-scrim')?.addEventListener('click', () => setMenu(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  // See-through over the top of the home hero; solid black everywhere else.
  const update = () => {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    const y = header.offsetHeight + 1;
    const under = document
      .elementsFromPoint(window.innerWidth / 2, y)
      .find((el) => !header.contains(el));
    const overHero = !scrolled && !!under?.closest('.hero');
    header.classList.toggle('dark-solid', !overHero);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);

  // Hide on scroll down, show on scroll up. Full size within the top 100px; anywhere below that it
  // comes back as the compact 64px bar. The switch to compact happens while the header is out of
  // view, so the only movement anyone sees is the slide.
  if (header) {
    const TOP = 100;
    const WOBBLE = 6; // ignore smaller movements (phone bounce, a resting finger)
    const SLIDE_MS = 250;
    let lastY = Math.max(0, window.scrollY);
    let compactTimer: number | undefined;

    const show = () => header.classList.remove('is-hidden');
    const hide = () => {
      if (header.classList.contains('menu-open')) return;
      header.classList.add('is-hidden');
      window.clearTimeout(compactTimer);
      compactTimer = window.setTimeout(() => {
        if (header.classList.contains('is-hidden')) header.classList.add('compact');
      }, SLIDE_MS);
    };

    // Loaded partway down the page (a refresh, or a link to a section): start compact
    if (lastY > TOP) header.classList.add('compact');

    const onScroll = () => {
      const y = Math.max(0, window.scrollY);
      if (y <= TOP) {
        window.clearTimeout(compactTimer);
        header.classList.remove('compact');
        show();
        lastY = y;
        return;
      }
      const dy = y - lastY;
      if (Math.abs(dy) < WOBBLE) return;
      if (dy > 0) hide();
      else {
        // Below the top it always comes back compact, even after a quick flick down and up
        header.classList.add('compact');
        show();
      }
      lastY = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // Tabbing into a hidden header brings it back
    header.addEventListener('focusin', show);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    /* Height of the bar: full at the top of the page, 64px once compact */
    --bar-h: var(--header-h);
    transition:
      border-color 0.25s,
      transform 0.25s var(--ease);
    /* Dark tokens everywhere, so nav text, menu bars and the mobile menu are white on black */
    --bg: var(--black);
    --text: #ffffff;
    --muted: rgba(255, 255, 255, 0.7);
    --line: rgba(255, 255, 255, 0.2);
  }
  .header.dark-solid,
  .header.menu-open {
    border-bottom-color: var(--line);
  }
  /* Slid up out of view (a few px more than its height, so the bottom rule goes too) */
  .header.is-hidden {
    transform: translateY(calc(-100% - 2px));
  }
  /* Compact: 64px, logo at 60%, always solid black */
  .header.compact {
    --bar-h: 64px;
  }
  .header.compact::before {
    opacity: 1;
  }
  .header.compact::after {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .header,
    .bar,
    .logo img {
      transition: none !important;
    }
  }
  /* Over the hero video: a soft dark fade behind the bar that dissolves to nothing */
  .header:not(.dark-solid, .menu-open)::after {
    content: '';
    position: absolute;
    inset: 0 0 -70% 0;
    z-index: -2;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(11, 11, 11, 0.6) 0%, rgba(11, 11, 11, 0.3) 55%, rgba(11, 11, 11, 0) 100%);
  }
  /* Flat backing colour on a pseudo-element, so it can fade in without touching the fixed mobile menu */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--black);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .header.dark-solid::before,
  .header.menu-open::before {
    opacity: 1;
  }

  /* ---------- The row ---------- */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.25rem;
    height: var(--bar-h);
    padding: 0 48px;
    transition: height 0.25s var(--ease);
  }
  .logo {
    display: block;
    flex: none;
  }
  .logo img {
    display: block;
    height: 40px;
    width: auto;
    transition: height 0.25s var(--ease);
  }
  .header.compact .logo img {
    height: 24px;
  }

  /* Links grouped together, then the button: plain text, 36px apart, no boxes or dividers */
  .nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    /* All caps, spaced out a little so the capitals stay easy to read */
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.2s;
  }
  .nav ul a:hover,
  .nav ul a:focus-visible {
    color: var(--text);
  }
  /* Current page: white, with a 2px orange underline */
  .nav ul a[aria-current='page'] {
    color: var(--text);
  }
  .nav ul a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: #c2410c;
  }

  /* Book a session: the small version of the site button. A thin white outline with a faint
     white tint on hover; filled white on the booking page */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid #ffffff;
    border-radius: 0.6rem;
    background: transparent;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: #ffffff;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      scale 0.15s ease;
  }
  .nav-cta:hover,
  .nav-cta:focus-visible {
    background: rgba(255, 255, 255, 0.12);
  }
  .nav-cta:active {
    scale: 0.98;
  }
  .nav-cta[aria-current='page'] {
    background: #ffffff;
    color: var(--black);
  }

  .bar-end,
  .menu-scrim {
    display: none;
  }

  /* ---------- Phones and small screens: logo + menu button, links in a full-screen menu ---------- */
  @media (max-width: 960px) {
    .bar {
      padding: 0 var(--pad);
    }
    .logo {
      /* The logo file carries a little padding, so pull it to the page edge */
      margin-left: -0.4rem;
    }
    .logo img {
      height: 36px;
    }
    .header.compact .logo img {
      height: 22px;
    }
    .menu-toggle {
      /* Stays above the open menu, so it becomes the close button in the menu's corner */
      position: relative;
      z-index: 3;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-right: -0.6rem;
      padding: 0;
      background: none;
      border: 0;
      cursor: pointer;
    }
    /* Two thin lines that cross into an X when the menu is open */
    .bars {
      position: relative;
      display: block;
      width: 24px;
      height: 8px;
    }
    .bars::before,
    .bars::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 1.5px;
      background: var(--text);
      transition: transform 0.4s var(--ease);
    }
    .bars::before {
      top: 0;
    }
    .bars::after {
      bottom: 0;
    }
    .menu-toggle[aria-expanded='true'] .bars::before {
      transform: translateY(3.25px) rotate(45deg);
    }
    .menu-toggle[aria-expanded='true'] .bars::after {
      transform: translateY(-3.25px) rotate(-45deg);
    }

    /* The page beside the open menu, darkened. The top bar stays visible above it */
    .menu-scrim {
      display: block;
      position: fixed;
      inset: var(--bar-h) 0 0;
      z-index: 1;
      background: rgba(0, 0, 0, 0.6);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.4s var(--ease),
        visibility 0.4s;
    }
    .header.menu-open .menu-scrim {
      opacity: 1;
      visibility: visible;
    }

    /* Side menu that slides in from the right, under the top bar: small capitals, each with a
       chevron at the right end, then the Book a session button centred beneath */
    .nav {
      position: fixed;
      top: var(--bar-h);
      right: 0;
      z-index: 2;
      width: min(82vw, 22rem);
      height: calc(100dvh - var(--bar-h));
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 2rem var(--pad) calc(2rem + env(safe-area-inset-bottom));
      border-left: 1px solid var(--line);
      background: var(--bg);
      overflow-y: auto;
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform 0.45s var(--ease),
        visibility 0.45s;
    }
    .nav.open {
      transform: none;
      visibility: visible;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      /* In the upper part of the panel: clear of the top bar, but not down in the middle */
      margin-top: 6vh;
    }
    .nav ul a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-block: 0.95rem;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.6);
    }
    /* A thin chevron (not an arrow) at the right end of each link */
    .nav ul a::before {
      content: '';
      order: 2;
      width: 0.4rem;
      height: 0.4rem;
      margin-right: 0.2rem;
      border-top: 1.5px solid currentColor;
      border-right: 1.5px solid currentColor;
      transform: rotate(45deg);
    }
    .nav ul a:hover,
    .nav ul a:focus-visible,
    .nav ul a[aria-current='page'] {
      color: #ffffff;
    }
    .nav ul a[aria-current='page']::after {
      display: none;
    }

    /* Book a session lives in the top bar on phones (BOOK), so it's left out of the menu */
    .nav-cta {
      display: none;
    }
    .bar-end {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    /* BOOK: a small soft see-through button, like MESSAGE ME */
    .bar-book {
      display: inline-flex;
      align-items: center;
      min-height: 2.125rem;
      padding: 0.35rem 0.9rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.16);
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      line-height: 1.2;
      text-transform: uppercase;
      text-decoration: none;
      color: #ffffff;
      transition: background-color 0.2s ease;
    }
    .bar-book:hover,
    .bar-book:focus-visible,
    .bar-book[aria-current='page'] {
      background: rgba(255, 255, 255, 0.26);
    }
  }
  @media (max-width: 960px) and (prefers-reduced-motion: reduce) {
    .nav,
    .menu-scrim {
      transition: none;
    }
  }
</style>
