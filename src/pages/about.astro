---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';
import { ABOUT_CLIPS, BASE_AREA, BRAND, SOCIALS } from '../config';

const socials = [
  { name: 'instagram' as const, label: 'Instagram', url: SOCIALS.instagram },
  { name: 'tiktok' as const, label: 'TikTok', url: SOCIALS.tiktok },
];

/* Example copy for Mustafa's story and training approach. */

const principles = [
  { title: 'Strong', text: 'Strength is the foundation. We build it properly with bodyweight and weights, so everything else gets easier.' },
  { title: 'Lean', text: "Good training and realistic nutrition, not crash diets. You'll get leaner in a way you can actually keep up." },
  { title: 'Mobile', text: 'Moving well matters as much as lifting heavy. We keep your joints healthy so you can train for years without niggles.' },
  { title: 'Explosive', text: 'Speed, power and athleticism. Train to perform, not just to look the part.' },
  { title: 'Consistent', text: "Small wins, week after week. Discipline beats motivation, and I'll help you build habits that last." },
];
---

<Layout
  tab="About"
  description={`Meet Mustafa, the personal trainer behind ${BRAND}. Based in ${BASE_AREA}, Central London. My story, training philosophy and what drives me.`}
>
  <!-- Story: personal introduction beside a large portrait -->
  <section class="section on-dark story-section">
    <div class="container story">
      <ImageSlot label="Portrait of Mustafa" src="/images/mustafa.webp" ratio="1 / 1.08" class="story-photo" />
      <div class="story-text">
        <h2 class="story-subheading" data-reveal>About me</h2>
        <div>
          <p class="first" data-reveal>I'm Mustafa, a personal trainer based in Marylebone, Central London. I've been training calisthenics since 2019, I still play football and I run, so I train myself as an all-round athlete, not just to look good in the mirror.</p>
          <p class="first" data-reveal>That's exactly how I coach. Most of my clients are busy professionals who want to feel strong, move well and have energy for everything else going on in their lives. I build every plan around you, your schedule and what you actually want to get out of it. That could be your first pull-up, getting back to sport after an injury or just finally feeling fit again.</p>
          <h2 class="story-subheading" data-reveal>Why train with me</h2>
          <p class="first" data-reveal>I practise what I coach. Every skill and method I use, I've worked through myself, so I know what it takes and how to get you there safely.</p>
          <p class="first" data-reveal>You get a plan that fits your life, not a generic template. I keep things honest, realistic and progressive, so you see real results and they stick.</p>
          <p class="first" data-reveal>I actually care about how you're getting on, between sessions as well as in them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote: one section split in half. Quote left, image filling the right half -->
  <section class="split quote-section">
    <div class="split-text quote-text">
      <figure class="quote" data-reveal>
        <blockquote>
          <p>THE REAL PROGRESS STARTS IN THE KITCHEN,<br /><mark class="highlight">THE REST IS JUST A BONUS.</mark></p>
        </blockquote>
      </figure>
    </div>
    <div class="split-media">
      <ImageSlot label="A colourful meal with vegetables and chickpeas" src="/images/anna-pelzer-IGfIGP5ONV0-unsplash.jpg" ratio="auto" reveal={false} />
    </div>
  </section>

  <!-- Philosophy: one ruled row per principle -->
  <section class="section on-dark philosophy-section">
    <div class="container narrow">
      <div class="section-head" data-reveal>
        <h2>My training philosophy</h2>
      </div>
      <p class="philosophy-intro" data-reveal>Live like an athlete. You don't need to be a pro to train like one. It's about building a body that's strong, capable and ready for anything.</p>
      <ol class="principles">
        {
          principles.map((p, i) => (
            <li data-reveal style={`--d: ${i}`}>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Follow my training: one section split in half. Montage filling the left half, text right -->
  <section class="split split--flip follow-section">
    <div class="split-media" data-clips aria-hidden="true">
      {
        ABOUT_CLIPS.map((clip, i) => (
          <div class:list={['clip', { 'is-active': i === 0 }]}>
            <ImageSlot label={clip.alt} type="video" src={clip.src} ratio="auto" reveal={false} />
          </div>
        ))
      }
    </div>
    <div class="split-text follow-text">
      <div class="follow-inner">
        <h2 data-reveal>Follow my training</h2>
        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                {s.url ? (
                  <a class="btn btn--ghost social-btn" href={s.url} target="_blank" rel="noopener">
                    <Icon name={s.name} />
                    {s.label}
                    <span class="visually-hidden">(opens in new tab)</span>
                  </a>
                ) : (
                  /* TODO: add the URL in src/config.ts (SOCIALS) to make this a link */
                  <span class="btn btn--ghost social-btn is-soon">
                    <Icon name={s.name} />
                    {s.label}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  // "Follow my training" montage: fade to the next clip every 6s (paused while the tab is hidden).
  // Only the visible clip plays; with reduced motion nothing rotates or autoplays.
  const clips = document.querySelector<HTMLElement>('[data-clips]');
  if (clips) {
    const frames = Array.from(clips.querySelectorAll<HTMLElement>('.clip'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;

    const sync = () => {
      frames.forEach((frame, i) => {
        const video = frame.querySelector('video');
        if (!video) return;
        if (i === active && !reduce) video.play().catch(() => {});
        else video.pause();
      });
    };

    const show = (next: number) => {
      frames[active].classList.remove('is-active');
      active = next;
      frames[active].classList.add('is-active');
      sync();
    };

    sync();
    if (frames.length > 1 && !reduce) {
      window.setInterval(() => {
        if (!document.hidden) show((active + 1) % frames.length);
      }, 6000);
    }
  }
</script>

<style>

  /* Story */
  .story {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .story :global(.story-photo) {
    width: 85%;
    max-width: none;
    margin-inline: auto;
  }
  .story-section {
    padding-top: calc(var(--header-h) + 2rem);
  }
  /* Simple left-aligned headings and readable copy, following the portrait-led layout */
  .story-subheading {
    margin: 0 0 0.8rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-align: left;
  }
  .story-text > div p {
    margin-bottom: 1rem;
    font-size: clamp(0.92rem, 1.05vw, 1rem);
    line-height: 1.5;
    color: var(--text);
  }
  .story-text > div p + .story-subheading {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }
  .story-text > div p:last-child {
    margin-bottom: 0;
  }
  @media (min-width: 700px) {
    .story {
      grid-template-columns: 1fr 1fr;
    }
    /* The photo sets the frame: it fills the row's full height, and the text sits inset
       within it, starting below the photo's top and ending above its bottom */
    .story {
      align-items: stretch;
    }
    .story :global(.story-photo) {
      grid-column: 1;
      grid-row: 1;
      aspect-ratio: auto !important;
      height: 100%;
      min-height: clamp(26rem, 42vw, 38rem);
    }
    .story :global(.story-photo img) {
      object-position: center;
    }
    .story-text {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      padding-block: clamp(2rem, 4vw, 3.5rem);
    }
  }
  @media (min-width: 961px) {
    .story-section {
      padding-top: 8.4rem;
    }
  }
  @media (max-width: 699px) {
    .story-section {
      padding-top: calc(var(--header-h) + 3rem);
    }
  }

  /* Principles */
  /* One ruled row per principle */
  .philosophy-intro {
    max-width: 42rem;
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    color: var(--text);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.5;
  }
  /* Less space under the last principle, and no closing rule after it */
  .philosophy-section {
    padding-bottom: calc(var(--section) * 0.5);
  }
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .principles li:last-child {
    padding-bottom: 0;
  }
  .principles li {
    padding-block: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--line);
    color: var(--text);
  }
  .principles h3 {
    margin: 0 0 0.8rem;
    color: var(--text);
  }
  .principles p {
    margin: 0;
    color: var(--muted);
  }

  /* Split sections: text in one half, media filling the other half edge to edge.
     The text keeps the page's outer margin on its outside edge. */
  .split {
    --edge: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad)));
    display: grid;
  }
  .split-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--section) var(--pad);
  }
  .split-media {
    position: relative;
    overflow: hidden;
    background: var(--black);
  }
  .split-media :global(.slot) {
    height: 100%;
  }
  .quote-section .split-media :global(img) {
    object-position: center;
    transform: scale(1.3);
    transform-origin: right center;
  }
  @media (min-width: 860px) {
    .split {
      grid-template-columns: 1fr 1fr;
      min-height: clamp(30rem, 80vh, 50rem);
    }
    /* The text hugs the middle, next to its image or video */
    .split-text {
      padding-left: var(--edge);
      padding-right: clamp(1.5rem, 3vw, 3rem);
    }
    /* Quote sits tight against the image: right-aligned, with only a small gap */
    .quote-text {
      align-items: flex-end;
      padding-right: clamp(1rem, 1.75vw, 1.5rem);
    }
    .quote blockquote p {
      text-align: right;
    }
    .split--flip .split-text {
      grid-column: 2;
      grid-row: 1;
      align-items: flex-start;
      padding-left: clamp(1.5rem, 3vw, 3rem);
      padding-right: var(--edge);
    }
    .split--flip .split-media {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* Quote */
  .quote {
    margin: 0;
  }
  .quote blockquote {
    margin: 0;
  }
  /* Marker-pen highlight in the site orange; the text stays black. Wraps cleanly across lines. */
  .highlight {
    padding: 0 0.12em;
    background: var(--accent);
    color: var(--black);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .quote blockquote p {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  /* Phones: image below the quote at a fixed shape */
  @media (max-width: 859px) {
    .quote-section .split-media {
      aspect-ratio: 4 / 3;
    }
  }

  /* Follow my training */
  .follow-section {
    margin-bottom: -1px;
  }
  .follow-text h2 {
    margin-bottom: 1.5rem;
    font-weight: 700;
    /* Lined up with the buttons under it (headings are centred site-wide) */
    text-align: left;
  }
  /* Heading and buttons as one group, centred in the white half, lined up on the left */
  .follow-inner {
    text-align: left;
  }
  @media (min-width: 860px) {
    .split--flip.follow-section .split-text {
      align-items: center;
    }
  }
  /* Which part of the montage stays in frame when it's cropped: 0% = top, 100% = bottom */
  .follow-section .split-media :global(video) {
    object-position: center 60%;
  }
  @media (max-width: 859px) {
    /* Full width always; the height is 4:5 of the width, capped at 75% of the screen.
       (Capping with max-height on an aspect-ratio box shrank the width and left white edges.) */
    .follow-section .split-media {
      width: 100%;
      aspect-ratio: auto;
      height: min(125vw, 75vh);
    }
  }
  /* Instagram, with TikTok below it; one column as wide as the wider button, so both match */
  .socials {
    display: grid;
    justify-content: start;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Solid black, dark grey on hover */
  .social-btn {
    --btn-bg: var(--black);
    --btn-fg: #ffffff;
    --btn-border: var(--black);
    --btn-fill: #2a2a2a;
    --btn-fill-fg: #ffffff;
    --btn-fill-border: #2a2a2a;
  }
  /* No URL yet: looks the same, but isn't interactive */
  .social-btn.is-soon {
    pointer-events: none;
  }

  /* Background clips: stacked full-bleed and cross-faded */
  .clip {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .clip.is-active {
    opacity: 1;
  }
  .clip :global(.slot) {
    height: 100%;
    background: var(--black);
  }
  /* iPhone Safari can leave a hairline of the page showing down each side of a video.
     The montage is drawn 1px past every edge (the box clips it), so it runs wall to wall. */
  .clip :global(video) {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }

</style>
