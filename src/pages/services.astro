---
import Layout from '../layouts/Layout.astro';
import ImageSlot from '../components/ImageSlot.astro';
import CtaBand from '../components/CtaBand.astro';
import { BASE_AREA, SERVICES } from '../config';

/* Three bands, alternating black and white. Only three services have a photo, so each band pairs
   one of them (photo on the left) with a text-only service: the pair's two services stack on the right. */
const PAIRS: [string, string][] = [
  ['calisthenics', 'body-recomposition'],
  ['strength-and-conditioning', 'sport-specific'],
  ['mobility-and-flexibility', 'rehabilitation'],
];
const find = (slug: string) => SERVICES.find((s) => s.slug === slug);
const bands = PAIRS.map((pair) => pair.map(find).filter((s) => s !== undefined));
const imageRatios = ['3 / 4', '5 / 4', '3 / 4'];
const SERVICE_IMAGES: Record<string, string> = {
  calisthenics: '/images/services1.png',
  'strength-and-conditioning': '/images/services2.png',
  'mobility-and-flexibility': '/images/services3.png',
};
---

<Layout
  tab="Services"
  description={`Strength & conditioning, sport-specific training, calisthenics, body recomposition, mobility and rehabilitation. One-to-one personal training in ${BASE_AREA} or private in-home training across central London.`}
>
  <!-- Three bands, one photo each: photo on the left, then the pair of services, each with its
       heading, one line and a sentence more -->
  <div class="bands">
    {
      bands.map((pair, i) => (
        <div class:list={['band', `band--${i + 1}`, { 'on-dark': i % 2 === 0 }]}>
          <div class="band-media">
            <ImageSlot
              label={`${pair[0].name} photo`}
              src={SERVICE_IMAGES[pair[0].slug]}
              ratio={imageRatios[i]}
            />
          </div>
          <div class="band-text">
            {pair.map((s) => (
              <section id={s.slug} class="band-svc">
                <h2 data-reveal>{s.name}</h2>
                <p class="lead" data-reveal>{s.short}</p>
                {s.body[0] && <p class="detail" data-reveal>{s.body[0]}</p>}
              </section>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <CtaBand
    title="Book a session"
    text={`One-to-one in ${BASE_AREA} or at your home. Pricing depends on how often you train.`}
    tone="grey"
  />
</Layout>

<style>
  /* ---------- Bands: one per service ---------- */
  /* Clear the fixed nav bar. The gap before the first photo sits inside the first band,
     so it takes that band's colour instead of showing as a white strip */
  .bands {
    padding-top: var(--header-h);
  }
  .band--1 {
    padding-top: 0;
  }
  @media (max-width: 760px) {
    .band--1 {
      padding-top: 12px;
    }
  }
  .band {
    display: grid;
  }
  .band-svc {
    scroll-margin-top: var(--header-h);
  }
  /* The pair's two services, split by a hairline */
  .band-svc + .band-svc {
    margin-top: clamp(2.125rem, 3.825vw, 2.975rem);
    padding-top: clamp(2.125rem, 3.825vw, 2.975rem);
    border-top: 1px solid var(--line);
  }
  /* Phones: the photo runs edge to edge above the text */
  .band-media {
    display: grid;
    place-items: center;
    aspect-ratio: 1.28 / 1;
  }
  .band--2 .band-media {
    aspect-ratio: 1.2 / 1;
  }
  .band--3 .band-media {
    aspect-ratio: 1.15 / 1;
  }
  .band-media :global(.slot) {
    width: 82%;
    height: auto;
  }
  .band--1 .band-media :global(.slot) {
    width: 53.86%;
  }
  .band--2 .band-media :global(.slot) {
    width: 76.752%;
  }
  .band--3 .band-media :global(.slot) {
    width: 53.86%;
  }
  .band--3 .band-media :global(img) {
    object-position: right center;
  }
  .band-text {
    padding: clamp(3.15rem, 9.2vw, 4.3rem) clamp(2.5rem, 10vw, 4rem) clamp(3.15rem, 9.2vw, 4.3rem) clamp(2rem, 6vw, 3rem);
  }
  @media (min-width: 900px) {
    /* The photo takes the left 45% of the screen from the edge, full band height; text the rest */
    .band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: clamp(27rem, 63vh, 39rem);
      padding-inline: clamp(3rem, 7vw, 7rem);
    }
    .band--2 {
      grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
      min-height: clamp(28rem, 66vh, 40rem);
    }
    .band--3 {
      grid-template-columns: minmax(0, 0.97fr) minmax(0, 1.03fr);
      min-height: clamp(27rem, 63vh, 39rem);
    }
    .band--1,
    .band--3 {
      padding-left: clamp(2rem, 4vw, 4rem);
      padding-right: clamp(6rem, 12vw, 12rem);
    }
    /* The photo sits inset in its space, with the band's own colour around it */
    .band-media {
      aspect-ratio: auto;
      padding-block: clamp(3.7rem, 7vw, 6.4rem);
      padding-inline: 0;
    }
    .band-media :global(.slot) {
      width: 90%;
    }
    .band--1 .band-media :global(.slot) {
      width: 58.22%;
    }
    .band--2 .band-media :global(.slot) {
      width: 84.24%;
    }
    .band--3 .band-media :global(.slot) {
      width: 58.22%;
    }
    .band-media :global(.slot) {
      justify-self: end;
    }
    .band--1 .band-media,
    .band--2 .band-media {
      padding-block: clamp(3rem, 5.5vw, 5rem);
    }
    .band--3 .band-media {
      padding-block: clamp(3rem, 5.5vw, 5rem);
    }
    /* In from the photo, and out to the site's 1100px column on the right. Padding percentages are
       of this column (55% of the band), so half the band is 100% / 1.1. */
    .band-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-self: center;
      padding-block: 0.5rem;
      padding-left: 1.5rem;
      padding-right: 0;
    }
  }

  .band h2 {
    margin-bottom: 0.85rem;
    font-size: clamp(1.03rem, 1.6vw, 1.4rem);
    font-weight: 800;
    line-height: 1.1;
    text-align: left;
  }
  /* Both lines of text under a service share one style */
  .band .lead,
  .band .detail {
    max-width: 26rem;
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .band .detail {
    margin-top: 0;
  }
</style>
