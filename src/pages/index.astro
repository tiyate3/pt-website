---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ImageSlot from '../components/ImageSlot.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { BRAND, BASE_AREA, GYM_ADDRESS, SERVICES, SOCIALS, STATIONS, TRAINER, WHATSAPP_NUMBER, WHATSAPP_URL } from '../config';
import { withBase } from '../utils/paths';

const sameAs = Object.values(SOCIALS).filter(Boolean);

// The short intro: in the hero on tablets and desktop, just under the hero on phones
const introText =
  "I'm Mustafa, a personal trainer based in Marylebone who trains as an all-round athlete. I help busy people get strong, move well and feel fit, with a plan built around their week.";
const addressParts = GYM_ADDRESS.match(/^(.*?)(?:\s+)([A-Z]{1,2}\d[A-Z\d]?\s?\d[A-Z]{2})$/i);

const gymMapUrl = `https://www.google.com/maps?q=${encodeURIComponent(GYM_ADDRESS)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(GYM_ADDRESS)}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND,
  description: `Personal trainer in Central London. Gym sessions in ${BASE_AREA} and private in-home personal training across Central London.`,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'London',
    addressCountry: 'GB',
  },
  areaServed: [
    { '@type': 'Place', name: 'Central London' },
    { '@type': 'City', name: 'London' },
  ],
  founder: { '@type': 'Person', name: TRAINER, jobTitle: 'Personal Trainer' },
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `${s.name} personal training` },
  })),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<Layout
  tab="Home"
  description={`Personal trainer in Central London, ${BASE_AREA} based, with private in-home personal training across Central London. Strength & conditioning, calisthenics, body recomposition, mobility and rehab. Book a session on WhatsApp or by enquiry.`}
  schema={schema}
>
  <!-- Hero: one looping clip behind the headline, set along the bottom -->
  <section class="hero on-dark">
    <div class="hero-media" aria-hidden="true">
      <video src={withBase('/media/about_me_montage.mp4')} autoplay muted loop playsinline preload="auto"></video>
    </div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container narrow hero-content">
      <!-- Headline and location line, with a soft charcoal smudge behind them -->
      <div class="hero-heading">
        <span class="hero-smudge" aria-hidden="true" data-reveal='image' style="--d: 0"></span>
        <h1 class="hero-title">
          <span class="line" data-reveal style="--d: 0">Train like an</span>
          <span class="line" data-reveal style="--d: 1">athlete</span>
        </h1>
        <p class="hero-sub" data-reveal style="--d: 2">Personal trainer in {BASE_AREA}, Central London</p>
      </div>
      <p class="hero-intro" data-reveal style="--d: 3">
        {introText}
        <a class="more-link" href={withBase('/about/')}>More about me</a>
      </p>

      <div class="hero-foot" data-reveal style="--d: 4">
        <WhatsAppButton class="hero-cta" label="Message me" icon />
      </div>
    </div>
  </section>

  <!-- Services ticker: runs straight under the hero -->
  <section class="services-ticker-section on-dark" aria-label="Training services">
    <p class="visually-hidden">
      Strength &amp; conditioning, Sport-specific training, Calisthenics, Body recomposition, Mobility &amp; flexibility, Rehabilitation.
    </p>
    <a class="ticker-strip" href={withBase('/services/')} aria-label="View all services">
      <div class="ticker-viewport">
        <div class="ticker-track">
          {[0, 1].map(() => (
            <div class="ticker-group" aria-hidden="true">
              {SERVICES.map((service) => (
                <span class="ticker-item">{service.name}<span class="ticker-dot" aria-hidden="true"></span></span>
              ))}
            </div>
          ))}
        </div>
      </div>
    </a>
  </section>

  <!-- Phones only: the intro sits here on white, just above "Where I train clients", to keep the hero uncluttered -->
  <section class="intro-phone" aria-label="About Mustafa">
    <div class="container">
      <p class="intro-phone-text">{introText}
        <a class="more-link" href={withBase('/about/')}>More about me</a></p>
    </div>
  </section>

  <!-- Where I train clients: centred heading and line, a rule under, then the two places side by side -->
  <section class="section where-section">
    <div class="container">
      <div class="where-head" data-reveal>
        <h2>Where I train clients</h2>
        <p>The gym in {BASE_AREA}, or your own home. Whichever suits you.</p>
      </div>
      <div class="where">
        <article class="place">
          <div class="place-media">
            <ImageSlot
              label={`Training in ${BASE_AREA}`}
              src="/media/gym-session.mp4"
              type="video"
              ratio="3 / 2"
            />
            <p class="place-bar">Gym sessions</p>
          </div>
          <div class="place-text" data-reveal>
            <h3>{BASE_AREA} based</h3>
            <p>One-to-one sessions in a fully kitted-out gym in Central London. Rigs, bars, rings and free weights, everything we need.</p>
          </div>
        </article>
        <article class="place">
          <div class="place-media">
            <ImageSlot
              label="Private in-home training montage"
              src="/media/home_videos_montage.mp4"
              type="video"
              ratio="3 / 2"
              delay={1}
            />
            <p class="place-bar">Across Central London</p>
          </div>
          <div class="place-text" data-reveal style="--d: 1">
            <h3>Private in-home personal training</h3>
            <p>No time to get to the gym? I'll come to you. Hardly any kit needed, and you won't waste time commuting.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <GoogleReviews />

  <!-- Booking, split in two: how it works on the left; WhatsApp first on the right, the email
       enquiry on its own /book/ page -->
  <section class="section on-dark book-section" id="book">
    <div class="container book-split">
      <div class="how">
        <h2>How it works</h2>
        <ol class="steps">
          <li><p><strong>Message me.</strong> Send a WhatsApp or fill in the form. A few lines on what you want is enough.</p></li>
          <li><p><strong>First session.</strong> We talk it through, I check how you move, and we do a workout at your level.</p></li>
          <li><p><strong>Your plan.</strong> You leave knowing what we're doing and when.</p></li>
        </ol>
      </div>
    <div class="book">
      <div class="book-intro">
        <h2>Book a session</h2>
        <p>Tell me what you want to work on<br class="book-break" /> and when you're free.</p>
      </div>
      <!-- Buttons, then the email link under them -->
      <div class="book-actions">
        <div class="actions">
          <WhatsAppButton label="Message me" />
          <a class="btn btn--ghost" href={withBase('/services/')}>View my services</a>
        </div>
        <p class="email-prompt">Prefer email? <a class="email-link" href={withBase('/book/')}>Send an enquiry</a></p>
      </div>
    </div>
    </div>
  </section>
  <section class="section location-sections" aria-label="Location and contact">
    <!-- Find me and Get in touch stacked on the left, the map on the right -->
    <div class="container location-grid">
      <div class="location-copy">
        <section class="location-block find-block" aria-labelledby="find-heading">
          <h2 id="find-heading">Find me</h2>
          <div class="address-panel">
            <address>
              {addressParts ? <><span>{addressParts[1]}</span><span>{addressParts[2]}</span></> : GYM_ADDRESS}
            </address>
          </div>
          <ul class="stations" aria-label="Nearest stations">
            {
              STATIONS.map((st) => (
                <li>
                  <span class="station-name">{st.name}</span>
                  <span class="station-walk">{st.walk}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--ghost location-action" href={directionsUrl} target="_blank" rel="noopener">Get directions</a>
        </section>

        <section class="location-block contact-block" aria-labelledby="contact-heading">
          <h2 id="contact-heading">Get in touch</h2>
          <div class="location-follow">
            <ul>
              <li>
                <a href={WHATSAPP_URL} target="_blank" rel="noopener" data-umami-event="WhatsApp click"><span class="social-icon"><Icon name="whatsapp" /></span>WhatsApp</a>
              </li>
              <li>
                {SOCIALS.instagram ? (
                  <a href={SOCIALS.instagram} target="_blank" rel="noopener"><span class="social-icon"><Icon name="instagram" /></span>Instagram</a>
                ) : (
                  <span><span class="social-icon"><Icon name="instagram" /></span>Instagram</span>
                )}
              </li>
              <li>
                {SOCIALS.tiktok ? (
                  <a href={SOCIALS.tiktok} target="_blank" rel="noopener"><span class="social-icon"><Icon name="tiktok" /></span>TikTok</a>
                ) : (
                  <span><span class="social-icon"><Icon name="tiktok" /></span>TikTok</span>
                )}
              </li>
            </ul>
          </div>
        </section>
      </div>
      <div class="map-frame">
        <iframe
          class="location-map"
          src={gymMapUrl}
          title={`Map showing where I train in ${BASE_AREA}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hero clip: with reduced motion it stays on its first frame.
  const heroVideo = document.querySelector<HTMLVideoElement>('.hero-media video');
  if (heroVideo && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroVideo.removeAttribute('autoplay');
    heroVideo.pause();
  }

</script>


<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(34rem, 84svh, 52rem);
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }
  /* One looping clip behind the headline, darkened so the white type stays readable */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(11, 11, 11, 0.88) 0%,
      rgba(11, 11, 11, 0.5) 55%,
      rgba(11, 11, 11, 0.6) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: left;
  }
  /* Location line under the headline: plain sentence case, quieter than the headline */
  /* Headline, this line and the button share one 1.25rem rhythm, so they read as one block */
  .hero-sub {
    margin: 1.25rem 0 0;
    font-size: clamp(0.98rem, 1.3vw, 1.1rem);
    font-weight: 500;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.8);
  }
  .hero-title {
    font-size: clamp(2.1rem, 5vw, 3.8rem);
    font-weight: 900;
    line-height: 0.94;
    margin: 0;
    text-align: left;
  }
  .hero-title .line {
    display: block;
  }
  /* Soft, uneven charcoal smudge behind the headline and location line: a few overlapping soft
     patches, blurred together so it reads as a splash of shadow rather than a neat oval.
     Still, and fades in with the headline. */
  .hero-heading {
    position: relative;
    isolation: isolate;
  }
  .hero-smudge {
    position: absolute;
    inset: -45% -30% -50% -18%;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(38% 46% at 30% 42%, rgba(24, 24, 24, 0.72), transparent 70%),
      radial-gradient(30% 38% at 62% 34%, rgba(34, 34, 34, 0.55), transparent 72%),
      radial-gradient(34% 30% at 44% 72%, rgba(28, 28, 28, 0.6), transparent 70%),
      radial-gradient(18% 22% at 80% 58%, rgba(40, 40, 40, 0.4), transparent 75%),
      radial-gradient(14% 18% at 12% 70%, rgba(40, 40, 40, 0.35), transparent 75%);
    filter: blur(28px);
  }
  .hero-heading .hero-title,
  .hero-heading .hero-sub {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  @media (max-width: 600px) {
    .hero-smudge {
      inset: -35% -12% -40% -10%;
      filter: blur(20px);
    }
  }
  /* Hi, I'm Mustafa: two lines under the headline, with a quiet link to About */
  .hero-intro {
    max-width: 34rem;
    margin: clamp(1rem, 2vw, 1.4rem) 0 0;
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    text-align: left;
  }
  /* Desktop: the intro moves to the right, level with the bottom of the headline and buttons,
     instead of sitting in line under the headline */
  @media (min-width: 960px) {
    .hero .hero-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      column-gap: clamp(3rem, 7vw, 6rem);
      align-items: end;
      max-width: calc(var(--wide) + 2 * var(--pad));
    }
    .hero-content > :not(.hero-intro) {
      grid-column: 1;
    }
    .hero-intro {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
      margin: 0;
      padding-left: 1.25rem;
      border-left: 1px solid rgba(255, 255, 255, 0.35);
      font-size: 0.98rem;
    }
  }
  /* About me: its own line under the bio, underlined, in regular italic at the paragraph's size */
  .more-link {
    display: block;
    width: fit-content;
    margin-top: 0.9rem;
    color: var(--text);
    font-size: 1em;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .more-link:hover,
  .more-link:focus-visible {
    text-decoration-color: currentColor;
  }
  .hero-intro .more-link {
    color: #ffffff;
  }
  /* Phones: the intro leaves the hero and shows on white, just above "Where I train clients" */
  .intro-phone {
    display: none;
  }
  @media (max-width: 600px) {
    .hero .hero-intro {
      display: none;
    }
    .intro-phone {
      display: block;
      padding-top: 2.25rem;
      background: var(--bg);
    }
    .intro-phone-text {
      margin: 0;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--muted);
    }

  }
  .hero-foot {
    display: grid;
    justify-items: start;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }
  .hero-foot .lead {
    margin: 0;
  }
  /* Phones: a smaller MESSAGE ME button */
  @media (max-width: 600px) {
    .hero-foot :global(.btn--whatsapp) {
      min-height: 2.5rem;
      padding: 0.55rem 1.15rem;
      font-size: 0.8rem;
    }
  }

  /* Home page only: a third less space above and below each section */
  .section {
    padding-block: calc(var(--section) * 0.67);
  }

  /* ---------- Where ---------- */
  /* Sits close under the services ticker */
  .where-section {
    padding-top: clamp(2rem, 4vw, 3rem);
  }
  /* Section opener, left-aligned like the rest of the page: a larger heading, the line in a
     narrow measure beneath it, and a full-width rule closing it off above the images */
  .where-head {
    display: grid;
    justify-items: start;
    gap: 0.85rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .where-head h2 {
    margin: 0;
    text-align: left;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  /* One line on tablets and desktop; it only wraps where the screen is too narrow */
  .where-head p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .where {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 760px) {
    .where {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(1.5rem, 4vw, 4rem);
    }
  }
  /* A long bar along the bottom of each image, carrying its label */
  .place-media {
    position: relative;
  }
  .place-bar {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    margin: 0;
    padding: 0.8rem clamp(1rem, 2vw, 1.4rem);
    background: rgba(11, 11, 11, 0.72);
    color: #ffffff;
    font-family: var(--font-nav);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
  }
  /* Short left-aligned caption under each image, lined up with its left edge */
  .place-text {
    max-width: 28rem;
    margin-top: 1.5rem;
    text-align: left;
  }
  .place-text h3 {
    margin-bottom: 0.9rem;
    font-size: 1rem;
    font-weight: 800;
  }
  .place-text > p {
    font-size: 1.02rem;
    line-height: 1.5;
  }
  .place-text p:last-child {
    margin: 0;
  }

  /* ---------- Training ticker ---------- */
  /* A black band with a hairline above, so it reads as part of the page rather than a banner */
  .services-ticker-section {
    padding-bottom: 0;
    background: #000000;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ticker-strip {
    display: block;
    width: 100%;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .ticker-strip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .ticker-viewport {
    overflow: hidden;
    padding-block: clamp(0.9rem, 2vw, 1.4rem);
  }
  /* translate3d + will-change keep the scroll on the GPU, so it glides instead of stepping */
  .ticker-track {
    display: flex;
    width: max-content;
    animation: services-marquee 70s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }
  .ticker-group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    padding-inline: clamp(1rem, 2vw, 2rem);
    white-space: nowrap;
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }
  /* A small grey dot between names */
  .ticker-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
  }
  .ticker-strip:hover .ticker-track,
  .ticker-strip:focus-within .ticker-track {
    animation-play-state: paused;
  }
  @keyframes services-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      width: 100%;
      animation: none;
      transform: none;
    }
    .ticker-group {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }
    .ticker-group + .ticker-group {
      display: none;
    }
    .ticker-item {
      gap: 0.75rem;
    }
  }

  /* ---------- Booking: how it works | book a session ---------- */
  .book-split {
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.5rem);
  }
  @media (min-width: 860px) {
    .book-split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0;
    }
    .how {
      padding-right: clamp(2.5rem, 5vw, 4.5rem);
      border-right: 1px solid var(--line);
    }
    .book {
      padding-left: clamp(2.5rem, 5vw, 4.5rem);
    }
  }
  .how h2 {
    margin-bottom: 1.5rem;
    text-align: left;
  }
  /* Three steps as a plain numbered list: a bold lead-in, then the sentence */
  .steps {
    display: grid;
    gap: 1.1rem;
    max-width: 30rem;
    margin: 0;
    padding-left: 1.25rem;
  }
  .steps li::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .steps li {
    padding-left: 0.35rem;
  }
  .steps p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .steps strong {
    color: var(--text);
    font-weight: 600;
  }
  .book {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }
  .book-intro {
    text-align: left;
  }
  .book-intro h2 {
    margin-bottom: 1.5rem;
    text-align: left;
  }
  .book-intro p {
    max-width: 30rem;
    margin: 0;
    font-size: 1.08rem;
  }
  /* Break before "and when you're free", so the second line is those four words. On small
     phones the first part wouldn't fit on one line, so the text wraps naturally instead. */
  @media (max-width: 359px) {
    .book-break {
      display: none;
    }
  }
  /* The link sits under the buttons, its underline only as wide as its text */
  .book-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .book-actions .actions {
    justify-content: flex-start;
  }
  .book-actions .email-prompt {
    margin-top: 1.75rem;
  }
  /* ---------- Find me and get in touch ---------- */
  /* White, between the black booking band and the black footer */
  .location-sections {
    background: var(--bg);
    /* Tighter than the other home sections */
    padding-block: calc(var(--section) * 0.45);
  }
  /* Info stacked on the left, the map filling the right and matching the column's height */
  .location-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 860px) {
    .location-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      column-gap: clamp(2rem, 3.5vw, 3rem);
      align-items: stretch;
    }
