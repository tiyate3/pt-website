---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';

const faqs = [
  {
    q: 'How much does it cost?',
    a: "It depends on your plan and how often you train. Message me and I'll send you my rates.",
  },
  {
    q: 'How far do you travel for home visits?',
    a: "Home visits cover Central London. Send me your postcode if you're unsure and I'll confirm.",
  },
  {
    q: 'Do you do online sessions?',
    a: 'Sometimes, depending on availability. Message me and we can talk about it.',
  },
  {
    q: "I'm a complete beginner. Is that okay?",
    a: 'Yes. Every plan starts from where you are now. We build the basics first and progress at a pace that suits you.',
  },
  {
    q: 'Do I need a gym membership to train with you at the gym?',
    a: 'No membership needed. You train with me at the gym as my guest.',
  },
  {
    q: 'What happens in the first session?',
    a: 'We talk through your goals, check how you move, and do a first workout pitched to your level, so you leave with a clear idea of the plan.',
  },
];
---

<Layout
  tab="FAQs"
  description="Answers to common questions about personal training, sessions, and getting started."
>
  <PageHead
    title="FAQs"
    intro="Answers to common questions about training with me."
    variant="dark"
  />

  <section class="section on-dark faq-section" aria-label="Frequently asked questions">
    <div class="container narrow">
      <div class="faq">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>
                {f.q}
                <span class="faq-mark" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-section {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--black);
  }
  .faq {
    text-align: left;
  }
  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-item:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  .faq-item summary {
    position: relative;
    padding: 1.1rem 2.5rem 1.1rem 0;
    list-style: none;
    cursor: pointer;
    font-weight: 700;
    color: var(--text);
    text-transform: uppercase;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-mark {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    width: 0.85rem;
    height: 0.85rem;
    transform: translateY(-50%);
  }
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .faq-mark::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .faq-mark::after {
    transform: rotate(0deg);
  }
  .faq-item p {
    margin: 0 0 1.25rem;
    max-width: 38rem;
    color: var(--muted);
  }
</style>
